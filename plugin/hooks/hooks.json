{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries claude-code",
            "timeout": 300
          },
          { "type": "command", "command": "mcpls brief", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "mcpls hook post-tool-use --harness claude-code" }]
      }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "mcpls hook post-tool-batch --harness claude-code" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "mcpls hook user-prompt-submit --harness claude-code" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "mcpls hook session-end --harness claude-code" }] }
    ]
  }
}
