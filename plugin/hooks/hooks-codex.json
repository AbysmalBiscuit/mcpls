{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries codex",
            "commandWindows": "& \"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries codex",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [{ "type": "command", "command": "mcpls hook post-tool-use --harness codex" }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "mcpls hook user-prompt-submit --harness codex" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "mcpls hook session-end --harness codex" }] }
    ]
  }
}
