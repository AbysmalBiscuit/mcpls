{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$GROK_PLUGIN_ROOT/hooks/run-hook.cmd\" bootstrap-binaries grok",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "search_replace|write",
        "hooks": [{ "type": "command", "command": "mcpls hook post-tool-use --harness grok" }]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "mcpls hook session-end --harness grok" }] }
    ]
  }
}
